<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical">
<include layout="@layout/layout_appbar" android:layout_width="match_parent" android:layout_height="wrap_content"/>
<ScrollView android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true" android:padding="20dp">
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
<TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="节点订阅" android:textSize="22sp" android:textStyle="bold"/>
<com.google.android.material.textfield.TextInputLayout android:id="@+id/subscription_input_layout" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:hint="粘贴订阅链接">
<com.google.android.material.textfield.TextInputEditText android:id="@+id/subscription_url" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="textUri" android:maxLines="2"/>
</com.google.android.material.textfield.TextInputLayout>
<com.google.android.material.button.MaterialButton android:id="@+id/import_subscription" android:layout_width="match_parent" android:layout_height="54dp" android:layout_marginTop="10dp" android:text="导入订阅"/>
<com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="24dp" app:cardCornerRadius="18dp" app:cardElevation="0dp">
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="18dp">
<TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="自动测速与连接" android:textSize="18sp" android:textStyle="bold"/>
<TextView android:id="@+id/connection_status" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="等待导入订阅"/>
<com.google.android.material.button.MaterialButton android:id="@+id/connect_best_node" android:layout_width="match_parent" android:layout_height="58dp" android:layout_marginTop="14dp" android:text="测速并连接最佳节点"/>
</LinearLayout>
</com.google.android.material.card.MaterialCardView>
<com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" app:cardCornerRadius="18dp" app:cardElevation="0dp">
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal" android:padding="18dp">
<LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
<TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="应用分流" android:textSize="18sp" android:textStyle="bold"/>
<TextView android:id="@+id/proxy_apps_summary" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:text="默认全部直连"/>
</LinearLayout>
<com.google.android.material.button.MaterialButton android:id="@+id/select_apps" style="@style/Widget.Material3.Button.OutlinedButton" android:layout_width="wrap_content" android:layout_height="48dp" android:text="选择应用"/>
</LinearLayout>
</com.google.android.material.card.MaterialCardView>
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="18dp" android:text="未勾选的应用始终直连。敏感应用请勿勾选。" android:textSize="12sp"/>
</LinearLayout>
</ScrollView>
</LinearLayout>