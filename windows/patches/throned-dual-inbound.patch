diff --git a/include/database/SettingsRepo.h b/include/database/SettingsRepo.h
--- a/include/database/SettingsRepo.h
+++ b/include/database/SettingsRepo.h
@@ -283,1 +283,3 @@
-    int inbound_socks_port = 2080; // Mixed, actually
+    // Auto Connect: stable loopback proxy ports. The legacy setting name is
+    // retained for database compatibility; this is now the SOCKS5 listener.
+    int inbound_socks_port = 7891;
diff --git a/src/configs/generate.cpp b/src/configs/generate.cpp
--- a/src/configs/generate.cpp
+++ b/src/configs/generate.cpp
@@ -58,1 +58,2 @@
 constexpr auto mixedIn = "mixed-in";
+constexpr auto httpIn = "http-in";
@@ -1449,14 +1450,24 @@
     if (!settings.disable_mixed_inbound) {
-        QJsonObject inboundObj;
-        inboundObj["tag"] = tags::mixedIn;
-        inboundObj["type"] = "mixed";
-        inboundObj["listen"] = settings.inbound_address;
-        inboundObj["listen_port"] = settings.inbound_socks_port;
-        if (settings.inbound_auth) {
-            inboundObj["users"] = QJsonArray{
-                QJsonObject{
-                    {"username", settings.inbound_user},
-                    {"password", settings.inbound_pass}}};
-        }
-        inbounds += inboundObj;
+        QJsonArray users;
+        if (settings.inbound_auth) {
+            users = QJsonArray{QJsonObject{
+                {"username", settings.inbound_user},
+                {"password", settings.inbound_pass}}};
+        }
+
+        // Separate protocol listeners make browser-extension configuration
+        // deterministic: HTTP CONNECT on 7890, SOCKS5 on the configured port
+        // (7891 by default). Both remain loopback-only by default.
+        inbounds += QJsonObject{
+            {"tag", tags::mixedIn},
+            {"type", "socks"},
+            {"listen", settings.inbound_address},
+            {"listen_port", settings.inbound_socks_port},
+            {"users", users},
+        };
+        inbounds += QJsonObject{
+            {"tag", httpIn},
+            {"type", "http"},
+            {"listen", settings.inbound_address},
+            {"listen_port", 7890},
+            {"users", users},
+        };
@@ -2463,1 +2473,1 @@
-                {"inbound", QJsonArray{tags::mixedIn, tags::tunIn}},
+                {"inbound", QJsonArray{tags::mixedIn, httpIn, tags::tunIn}},
