+void ConnectionManager::tryBootFailover(const StartRequest &request, StartOutcome outcome) {
+    ENGINE_CHECK_MAIN_THREAD();
+    if (!request.bootFailover || outcome != StartOutcome::StartFailed || m_bootFailoverAttempted) return;
+    m_bootFailoverAttempted = true;
+    if (m_tests == nullptr) return;
+
+    const auto failedProfile = Configs::dataManager->profilesRepo->GetProfile(request.profileId);
+    if (failedProfile == nullptr) return;
+    const int groupId = failedProfile->gid;
+    const auto group = Configs::dataManager->groupsRepo->GetGroup(groupId);
+    if (group == nullptr || group->archive) return;
+
+    QList<int> candidates;
+    for (const int id : group->Profiles()) {
+        if (id == request.profileId) continue;
+        const auto profile = Configs::dataManager->profilesRepo->GetProfile(id);
+        if (profile != nullptr && profile->gid == groupId && profile->outbound != nullptr) candidates.push_back(id);
+    }
+    if (candidates.isEmpty()) {
+        MW_show_log(QStringLiteral("[Auto Connect] The remembered node failed, and this group has no fallback candidates."));
+        return;
+    }
+
+    MW_show_log(QStringLiteral("[Auto Connect] The remembered node failed; actively testing %1 alternatives...")
+                    .arg(candidates.size()));
+    m_tests->queueUrlTests(candidates, [this, candidates, failedId = request.profileId, groupId] {
+        runOnUiThread([this, candidates, failedId, groupId] {
+            // A manual start or stop during testing always wins over this background recovery.
+            if (m_lastProfileId != failedId || connectionState() != ConnectionState::Idle) return;
+            const auto currentGroup = Configs::dataManager->groupsRepo->GetGroup(groupId);
+            if (currentGroup == nullptr || currentGroup->archive) return;
+
+            int bestId = -1;
+            int bestLatency = std::numeric_limits<int>::max();
+            for (const int id : candidates) {
+                const auto profile = Configs::dataManager->profilesRepo->GetProfile(id);
+                if (profile == nullptr || profile->gid != groupId || !profile->IsWorking()) continue;
+                const int score = profile->latency > 0 ? profile->latency : std::numeric_limits<int>::max() - 1;
+                if (score < bestLatency) {
+                    bestLatency = score;
+                    bestId = id;
+                }
+            }
+            if (bestId < 0) {
+                MW_show_log(QStringLiteral("[Auto Connect] No alternative node passed the URL reachability test."));
+                return;
+            }
+            MW_show_log(QStringLiteral("[Auto Connect] Switching to the best tested alternative (profile %1, %2 ms).")
+                            .arg(bestId)
+                            .arg(bestLatency == std::numeric_limits<int>::max() - 1 ? 0 : bestLatency));
+            start(StartRequest{bestId, false, 0});
+        });
+    }, false);
+}
